---
---

<section id="download" class="relative overflow-hidden pt-20 pb-16 md:pt-32 md:pb-24">
	<!-- Ambient Background Glow -->
	<div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-minotaur/15 blur-[120px]"></div>

	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
		<!-- Pill Tag -->
		<div class="inline-flex items-center gap-2 rounded-full border border-minotaur/30 bg-minotaur/10 px-4 py-1.5 text-xs font-semibold text-minotaur backdrop-blur-sm mb-8">
			<span class="inline-block h-2 w-2 rounded-full bg-minotaur animate-pulse"></span>
			<span>v1.0.0 Now Available for Windows</span>
		</div>

		<!-- Main Headline -->
		<h1 class="mx-auto max-w-4xl text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1]">
			The Fast, Privacy-First <br class="hidden sm:inline" />
			<span class="text-gradient">Minecraft Launcher</span>
		</h1>

		<!-- Subheadline -->
		<p class="mx-auto mt-6 max-w-2xl text-lg sm:text-xl text-slate-300 leading-relaxed">
			Play your way with offline and Microsoft accounts, built-in 3D skin customizer,
			automated modpack management, and zero telemetry.
		</p>

		<!-- Action Buttons -->
		<div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
			<a
				href="https://github.com/alvyn16/Minotaur/releases/download/v1.0.0/Minotaur_Launcher_1.0.0_x64_Setup.exe"
				class="group relative inline-flex w-full sm:w-auto items-center justify-center gap-3 rounded-xl bg-minotaur px-8 py-4 text-base font-bold text-black transition-all hover:bg-minotaur-light hover:shadow-xl hover:shadow-minotaur/30 active:scale-95"
			>
				<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.901-1.799"/>
				</svg>
				<span class="text-left">
					<span class="block text-xs uppercase tracking-wider text-black/70 font-semibold leading-none">Download Setup for</span>
					<span class="block text-base font-bold leading-tight">Windows 64-bit</span>
				</span>
			</a>

			<a
				href="https://github.com/alvyn16/Minotaur/releases/tag/v1.0.0"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl border border-dark-border bg-dark-card/80 px-6 py-4 text-base font-semibold text-white backdrop-blur-sm transition-all hover:bg-dark-cardHover hover:border-slate-600 active:scale-95"
			>
				<svg class="h-5 w-5 text-slate-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill-rule="evenodd"
						d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
						clip-rule="evenodd"
					></path>
				</svg>
				<span>View on GitHub</span>
			</a>
		</div>

		<!-- File details -->
		<p class="mt-3 text-xs text-slate-400">
			Setup Installer (.exe) • ~28 MB • Windows 10 &amp; 11 • Also available: <a href="https://github.com/alvyn16/Minotaur/releases/download/v1.0.0/Minotaur.exe" class="underline text-slate-300 hover:text-white">Portable .exe</a>
		</p>

		<!-- Trust Badges -->
		<div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400">
			<div class="flex items-center gap-2">
				<svg class="h-4 w-4 text-minotaur" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
				</svg>
				<span>Free &amp; Open Source (GPL-3.0)</span>
			</div>
			<div class="flex items-center gap-2">
				<svg class="h-4 w-4 text-minotaur" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
				</svg>
				<span>Zero Telemetry or Ads</span>
			</div>
			<div class="flex items-center gap-2">
				<svg class="h-4 w-4 text-minotaur" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
				</svg>
				<span>Automated Java Downloads</span>
			</div>
		</div>
	</div>
</section>
