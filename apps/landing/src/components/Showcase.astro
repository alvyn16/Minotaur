---
---

<section id="showcase" class="relative py-12 md:py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<!-- Screenshot Tabs Switcher -->
		<div class="flex flex-wrap items-center justify-center gap-2 mb-6">
			<button
				id="tab-library"
				type="button"
				class="tab-btn active inline-flex items-center gap-2 rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all border border-minotaur bg-minotaur/10 text-minotaur cursor-pointer"
				data-img="/screenshots/launcher-library.png"
			>
				Instance Library
			</button>
			<button
				id="tab-modpacks"
				type="button"
				class="tab-btn inline-flex items-center gap-2 rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all border border-dark-border bg-dark-card text-slate-400 hover:text-white hover:border-slate-600 cursor-pointer"
				data-img="/screenshots/launcher-modpacks.jpg"
			>
				Discover Modpacks
			</button>
			<button
				id="tab-skins"
				type="button"
				class="tab-btn inline-flex items-center gap-2 rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all border border-dark-border bg-dark-card text-slate-400 hover:text-white hover:border-slate-600 cursor-pointer"
				data-img="/screenshots/launcher-skins.jpg"
			>
				Skin Selector
			</button>
		</div>

		<div class="relative mx-auto rounded-2xl border border-dark-border bg-dark-card/90 p-2 sm:p-4 shadow-2xl shadow-minotaur/10">
			<!-- Window Title Bar -->
			<div class="flex items-center justify-between border-b border-dark-border/80 px-4 py-3 mb-2">
				<div class="flex items-center gap-2">
					<div class="h-3 w-3 rounded-full bg-red-500/80"></div>
					<div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
					<div class="h-3 w-3 rounded-full bg-green-500/80"></div>
				</div>
				<div class="text-xs font-medium text-slate-400 flex items-center gap-2">
					<span class="inline-block h-2 w-2 rounded-full bg-minotaur"></span>
					<span id="window-title">Minotaur Launcher - Instance Library</span>
				</div>
				<div class="w-12"></div>
			</div>

			<!-- Image Mockup -->
			<div class="relative overflow-hidden rounded-xl border border-dark-border/60 bg-[#12161a]">
				<img
					id="showcase-img"
					src="/screenshots/launcher-library.png"
					alt="Minotaur Launcher interface showing the instance library"
					class="w-full h-auto object-cover rounded-xl transition-opacity duration-200"
					loading="eager"
				/>
			</div>

			<!-- Caption / Highlights bar -->
			<div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 px-2 py-2 text-center text-xs text-slate-400">
				<div>
					<span class="font-semibold text-white">Instance Library:</span> Fast launch, group sorting, and custom filters
				</div>
				<div>
					<span class="font-semibold text-white">1-Click Modpacks:</span> Discover and install thousands of modpacks directly
				</div>
				<div>
					<span class="font-semibold text-white">3D Skin Selector:</span> Steve, Alex, Ari, and custom skin manager
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
	const img = document.getElementById('showcase-img') as HTMLImageElement | null;
	const title = document.getElementById('window-title');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			tabs.forEach((t) => {
				t.classList.remove('border-minotaur', 'bg-minotaur/10', 'text-minotaur');
				t.classList.add('border-dark-border', 'bg-dark-card', 'text-slate-400');
			});
			tab.classList.remove('border-dark-border', 'bg-dark-card', 'text-slate-400');
			tab.classList.add('border-minotaur', 'bg-minotaur/10', 'text-minotaur');

			const newSrc = tab.getAttribute('data-img');
			if (img && newSrc) {
				img.style.opacity = '0.5';
				setTimeout(() => {
					img.src = newSrc;
					img.style.opacity = '1';
				}, 100);
			}

			if (title) {
				title.textContent = `Minotaur Launcher - ${tab.textContent?.trim()}`;
			}
		});
	});
</script>
