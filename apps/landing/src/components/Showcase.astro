---
---

<section id="showcase" class="relative py-12 md:py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="relative mx-auto rounded-2xl border border-dark-border bg-dark-card/90 p-2 sm:p-4 shadow-2xl shadow-minotaur/10">
			<!-- Window Title Bar -->
			<div class="flex items-center justify-between border-b border-dark-border/80 px-4 py-3 mb-2">
				<div class="flex items-center gap-2">
					<div class="h-3 w-3 rounded-full bg-red-500/80"></div>
					<div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
					<div class="h-3 w-3 rounded-full bg-green-500/80"></div>
				</div>
				<div class="text-xs font-medium text-slate-400 flex items-center gap-2">
					<span class="inline-block h-2 w-2 rounded-full bg-minotaur"></span>
					<span>Minotaur Launcher</span>
				</div>
				<div class="w-12"></div>
			</div>

			<!-- Image Mockup -->
			<div class="relative overflow-hidden rounded-xl border border-dark-border/60 bg-[#12161a]">
				<img
					src="/screenshots/launcher-preview.jpg"
					alt="Minotaur Launcher interface showing the 3D skin customizer and offline accounts"
					class="w-full h-auto object-cover rounded-xl"
					loading="lazy"
				/>
			</div>

			<!-- Caption / Highlights bar -->
			<div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 px-2 py-2 text-center text-xs text-slate-400">
				<div>
					<span class="font-semibold text-white">3D Skin Selector:</span> Steve, Alex, Ari, and custom textures
				</div>
				<div>
					<span class="font-semibold text-white">Dual Mode Auth:</span> Microsoft &amp; Offline Accounts
				</div>
				<div>
					<span class="font-semibold text-white">Rust Engine:</span> Built on Tauri v2 for low RAM &amp; CPU usage
				</div>
			</div>
		</div>
	</div>
</section>
